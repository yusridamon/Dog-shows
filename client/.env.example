# ============================================================================
# Cape Rottweiler Club - Dog Shows - Client environment variables
# Copy to `.env` and fill in for production. Only REACT_APP_ vars are exposed.
# ============================================================================

# Base URL of the API (WITHOUT the trailing /api - the client appends it).
#
# Local development: LEAVE UNSET. The client defaults to '/api' and the CRA dev
# proxy (see "proxy" in package.json) forwards to http://localhost:5001.
#
# Production: set to the deployed API origin, e.g.
#   REACT_APP_API_URL="https://your-api.up.railway.app"
# REACT_APP_API_URL=""
