# ============================================================================
# Cape Rottweiler Club - Dog Shows - Server environment variables
# Copy this file to `.env` and fill in real values. All differences between
# local and production come from these variables, so the same code runs in both.
# ============================================================================

# --- Database (REQUIRED) ---------------------------------------------------
# PostgreSQL connection string. Managed hosts (Railway) provide their own,
# often with ?sslmode=require.
DATABASE_URL="postgresql://postgres:password@localhost:5432/dog_shows?schema=public"

# --- Auth (REQUIRED) -------------------------------------------------------
# In PRODUCTION use a long random secret: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="change_this_to_a_long_random_secret"
JWT_EXPIRES_IN="7d"

# --- Server ---------------------------------------------------------------
# Managed hosts inject PORT. Falls back to 5001 locally. Binds to 0.0.0.0.
PORT=5001
NODE_ENV="development"

# --- CORS / Client origin (REQUIRED) --------------------------------------
# Allowed browser origin(s). Single origin OR comma-separated list to allow
# the production domain and localhost together, e.g.
#   CLIENT_URL="https://cape-rottweiler-club.pages.dev,http://localhost:3000"
CLIENT_URL="http://localhost:3000"

# --- Uploads (REQUIRED in production) -------------------------------------
# Where uploaded pedigrees and entry forms are stored. Locally defaults to
# <server>/uploads. In production set this to a MOUNTED PERSISTENT VOLUME path
# (e.g. /data on Railway) so uploaded documents survive redeploys.
# UPLOADS_DIR="/data"

# --- Dog registry import (local one-off) ----------------------------------
# Path to the registry Excel export used by db:import.
DOG_IMPORT_FILE="C:\\Users\\User\\Downloads\\test.xlsx"
